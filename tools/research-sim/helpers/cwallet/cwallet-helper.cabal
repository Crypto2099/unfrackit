cabal-version: 3.0
-- SPDX-License-Identifier: Apache-2.0
-- Copyright 2026 Adam K. Dean
--
-- The cardano-wallet helper of the simulator's bridge (src/methods/helper.mjs,
-- schema 1). Its dependencies are what the adapter calls: cardano-balance-tx's
-- balanceTx over cardano-coin-selection, the ledger packages that decode the
-- request's CBOR and encode the transaction, and MonadRandom and random, the
-- source of the selection's random draws, which the adapter seeds from the
-- request. Every one of them is in cardano-balance-tx's own dependency closure
-- except aeson and base16-bytestring, which the ledger packages already
-- depend on.
name:          cwallet-helper
version:       0.1.0.0
license:       Apache-2.0
copyright:     2026 Adam K. Dean
build-type:    Simple

executable cwallet-helper
  main-is:          Main.hs
  hs-source-dirs:   .
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts
  build-depends:
    , aeson
    , base
    , base16-bytestring
    , bytestring
    , cardano-balance-tx
    , cardano-coin-selection
    , cardano-ledger-api
    , cardano-ledger-binary
    , cardano-ledger-conway
    , cardano-ledger-core
    , cardano-ledger-mary
    , cardano-ledger-shelley
    , cardano-slotting
    , cardano-strict-containers
    , containers
    , MonadRandom
    , random
    , text
    , transformers

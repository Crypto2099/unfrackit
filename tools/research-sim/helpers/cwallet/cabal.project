--
-- The cardano-wallet helper of the simulator's bridge (src/methods/helper.mjs).
-- It links cardano-balance-tx (cardano-foundation/cardano-balance-transaction
-- at 897577325745729552495a9add56c713630c497e) and cardano-coin-selection
-- (cardano-foundation/cardano-coin-selection at
-- 176611048d5b9f33df19d106cd925d63a7858bb2), pinned as cardano-wallet pins them
-- at cardano-wallet@f293d922f1930714aca7ede3cbb5ebf3fb710af6. Every stanza below
-- the helper's own `packages:` line is copied unchanged from that commit's
-- cabal.project; each block names the lines it copies. Left out are the
-- wallet's own packages (:58-86), its program-options (:255-259), its
-- cabal-lib-version (:261) and its test settings (:265, :267-335, :340), which
-- configure the wallet's local packages and pin nothing, and its three other
-- source-repository-package stanzas (servant-openapi3 and openapi3, :88-108,
-- and cardano-ledger-read, :122-132), packages that neither
-- cardano-balance-tx nor cardano-coin-selection depends on. A constraint or
-- flag on a package outside the helper's plan has no effect. The `--sha256`
-- lines are read by haskell.nix only; cabal ignores them.
--
-- The toolchain is cardano-balance-transaction's development shell at the same
-- commit (its flake's devShells.default, GHC 9.12.3 as nix/project.nix:41 sets
-- it, the compiler cardano-wallet builds with at nix/haskell.nix:122), which
-- scripts/haskell-prep.sh realizes. That repository's own cabal.project pins
-- the same CHaP repository, index-state and cardano-coin-selection commit, and
-- each ledger package it constrains at the version the wallet's block below
-- constrains.

packages: .

-- cardano-wallet@f293d92 cabal.project:40-49
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- cardano-wallet@f293d92 cabal.project:51-56
-- repeating the index-state for hackage to work around hackage.nix parsing limitation
index-state: 2026-08-14T13:38:07Z

index-state:
  , hackage.haskell.org 2026-08-14T13:38:07Z
  , cardano-haskell-packages 2026-09-23T18:57:23Z


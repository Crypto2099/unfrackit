-- SPDX-License-Identifier: Apache-2.0
-- Copyright 2026 Adam K. Dean
--
-- The Kuber helper of the simulator's bridge (src/methods/helper.mjs). It links
-- kuber 4.2.0 (dQuadrant/kuber, the release tag v4.2.0's commit
-- 2c559089e394ea7bc8a9bbde968bcdfb2ef7fac5), pinned below as a
-- source-repository-package at that commit, so the helper builds the
-- release's own source. Every other stanza below is copied unchanged from
-- kuber@2c55908 cabal.project, the pins Kuber builds itself with; each block
-- names the lines it copies. Left out are Kuber's own packages (:36-41) and
-- its test and benchmark settings (:52-54), which configure its local
-- packages and pin nothing. A constraint, allow-newer entry or flag on a
-- package outside the helper's plan has no effect.
--
-- Kuber has no Nix development shell: its own builds run cabal in the Docker
-- image cardanoapi/haskell:9.6.7 (.ci/build:66), and its index-state and
-- constraints follow cardano-node 11.0.1 (:16, "Match the package set selected
-- by cardano-node 11.0.1 from CHaP"; the index-state at :3-5 equals
-- cardano-node 11.0.1's). The toolchain is therefore cardano-node 11.0.1's
-- development shell (IntersectMBO/cardano-node at the tag's commit
-- 97036a66bcf8c89f687ae57a048eecc0389977ef, devShells.default), whose GHC is
-- 9.6.7 (nix/haskell.nix:45), the image's version, which
-- scripts/haskell-prep.sh realizes.

packages: .

-- dQuadrant/kuber at the release tag v4.2.0.
source-repository-package
  type: git
  location: https://github.com/dQuadrant/kuber
  tag: 2c559089e394ea7bc8a9bbde968bcdfb2ef7fac5

-- kuber@2c55908 cabal.project:1-34
-- See CONTRIBUTING for information about these, including some Nix commands
-- you need to run if you change them
index-state:
  , hackage.haskell.org 2026-03-26T20:21:33Z
  , cardano-haskell-packages 2026-05-02T16:21:41Z

active-repositories:
  , :rest
  , cardano-haskell-packages:override

constraints:
  -- haskell.nix patch does not work for 1.6.8
  , any.crypton-x509-system < 1.6.8
  -- haskell.nix tries to use 0.7.1.5 for some reason
  , any.proto-lens >= 0.7.1.6
  -- Match the package set selected by cardano-node 11.0.1 from CHaP.
  , any.cardano-api == 11.0.0.0
  , any.cardano-ledger-binary == 1.8.1.0
  , any.cardano-ledger-core == 1.20.0.0
  , any.cuddle == 1.1.1.0
  , any.ouroboros-consensus == 3.0.1.0
  , any.QuickCheck == 2.15.0.1

-- Custom repository for cardano haskell packages, see CONTRIBUTING for more
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

-- kuber@2c55908 cabal.project:43-50
-- You never, ever, want this.
write-ghc-environment-files: never

package acts
  flags: -finitary

package cardano-crypto-praos
  flags: -external-libsodium-vrf

-- kuber@2c55908 cabal.project:56-70
package cryptonite
  -- Using RDRAND instead of /dev/urandom as an entropy source for key
  -- generation is dubious. Set the flag so we use /dev/urandom by default.
  flags: -support_rdrand

package bitvec
  flags: -simd

allow-newer:
  , katip:Win32

-- Work around cabal solver issues present in newer dependency sets.
allow-newer:
  , io-sim:time
  , io-classes:time
